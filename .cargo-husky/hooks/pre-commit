#!/bin/sh
set -e
echo '+HPROF_UPDATE_SNAPSHOTS=1 cargo test --features native --lib emit_schema_matches_committed_file'
HPROF_UPDATE_SNAPSHOTS=1 cargo test --features native --lib emit_schema_matches_committed_file 2>/dev/null
git add schema/report.schema.json

# Regenerate golden JSON snapshot only when the LFS fixture is present and real
FIXTURE=tests/fixtures/dump_4_philosophers.hprof
if [ -f "$FIXTURE" ] && [ "$(wc -c < "$FIXTURE")" -ge 1024 ]; then
    echo '+HPROF_UPDATE_SNAPSHOTS=1 cargo test --features native --test integration json_golden_snapshot'
    HPROF_UPDATE_SNAPSHOTS=1 cargo test --features native --test integration json_golden_snapshot 2>/dev/null
    git add tests/fixtures/dump_4_philosophers_report.json
fi

echo '+cargo fmt --all -- --check'
cargo fmt --all -- --check
echo '+cargo clippy --all-targets --all-features -- -D warnings'
cargo clippy --all-targets --all-features -- -D warnings
